%ul
  - @profile.errors.full_messages.each do |message|
    %li= message

  = form_with(model: @profile, url: profile_path, method: 'put', local: true) do |f|
    %div
      = f.label :avatar, 'Profile Picture'
    %div
      = f.file_field :avatar
    %div
      = f.label :nickname, 'Name'
    %div
      = f.text_field :nickname, class: 'text'
    %div
      = f.label :department, 'Department'
    %div
      = f.text_field :department, class: 'text'
    %div
      = f.label :introduction, 'Introduction'
    %div
      = f.text_area :introduction
    %div
      = f.label :gender, 'Gender'
    %div
      = f.select :gender, Profile.genders.keys, {}, { class: 'text' }
    %div
      = f.label :birthday, 'Birthday'
    %div
      = f.date_field :birthday, class: 'text'
    %div
      = f.label :subscribed, 'Get Notifications'
      = f.check_box :subscribed
    = f.submit 'Update', class: 'btn-primary'
