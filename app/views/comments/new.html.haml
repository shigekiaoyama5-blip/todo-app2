%ul
  - @task.errors.full_messages.each do |message|
    %li= message

= form_with(model: @comment, url: task_comments_path(@comment.task), local: true) do |f|
  %div
    = f.label :content, 'New Comment', class: 'new-comment'
  %div
    = f.text_area :content
  = f.submit 'Submit', class: 'btn-mainly'
  %p= link_to 'Back', '#', onclick: 'history.back(); return false;', class: "back-btn"