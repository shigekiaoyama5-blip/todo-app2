= link_to task_path(task) do
  .card
    .card_title
      = task.title
    .card_description
      = truncate(task.description.to_plain_text, length: 100)
    .card_icon
      .user-icon
        = image_tag task.user.avatar_image, alt: "作成者", class: "icon creator"
        - task.comments.limit(4).each do |comment|
          = image_tag comment.user.avatar_image, alt: "コメント者", class: "icon commenter"
      .card_comments
        %p #{task.comments.count} 💬