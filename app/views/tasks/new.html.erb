<h1>New Board</h1>
  <%= form_with(model: @task, url: tasks_path, method: 'post', local: true) do |f| %>
    <div>
      <%= f.label :Name %>
      <%= f.text_field :title %>
    </div>
    <div>
      <%= f.label :Description %>
      <%= f.text_area :description %>
    </div>
    <%= f.submit 'Submit' %>
  <% end %>
<p><%= link_to '一覧に戻る', tasks_url %></p>
