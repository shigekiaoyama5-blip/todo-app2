.task
  .task_header
    %h1.task_title= @task.title
    .task_overall
    .task_detail_actions
    - if current_user.has_written?(@task)
      .dropdown
        = image_tag 'actions.svg', class: 'dropbtn'
        .dropdown_content
          = link_to 'Edit', edit_task_path(@task)
          = link_to 'Delete', task_path(@task), data: { turbo_method: 'delete', turbo_confirm: 'You sure delete it?' }
  .task_detail
    .task_description
      = @task.description
    %div
      %p= @task.author_name
    .task_deadline
      = "Deadline : #{I18n.l(@task.deadline, format: :default)}"
  %h2 Comment
  - @comments.each do |comment|
    .task_comment
      %p= comment.content
  = link_to new_task_comment_path(@task) do
    .btn-secondary
      + Add new comment
  %p= link_to 'Back', tasks_url, class: 'back-btn'
