<h1>Brackets</h1>
  <% @tasks.each do |task| %>
    <div class="card">
      <div class="card_title">
        <%= task.title %>
      </div>
      <div class="card_description">
        <%= task.description %>
      </div>
      <div class="card_comment">
        <span>44</span>
      </div>
    </div>
  <% end %>
<p><%= link_to '+ Add new card', new_task_path %></p>
