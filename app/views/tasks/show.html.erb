<div class="task">
  <h1 class="task_title"><%= @task.title %></h1>
  <div class="task_detail">
  </div>
  <div class="task_detail_actions">
    <div class="dropdown">
      <%= image_tag 'actions.svg', class: 'dropbtn' %>
      <div class="dropdown_content mini">
        <%= link_to 'Edit', edit_task_path(@task) %>
        <%= link_to 'Delete', task_path(@task), data: { turbo_method: 'delete', turbo_confirm: 'You sure delete it?' } %>
      </div>
    </div>
  </div>
  <div class="task_description">
    <%= @task.description %>
  </div>
  <div class="task_deadline">
    <%= I18n.l(@task.deadline, format: :default) %>
  </div>
</div>
<p>+ Add new comment </p>
<p><%= link_to '一覧に戻る', tasks_url %></p>