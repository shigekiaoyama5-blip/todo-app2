%h1 Brackets
- @tasks.each do |task|
  = link_to task_path(task) do
    .card
      .card_title
        = task.title
      .card_description
        = task.description
      - if task.user.present?
        %p= task.user.display_name
      .card_comment
        %span 44
%p= link_to '+ Add new card', new_task_path
